# ---------------------------------------------------------------------------
# CodeBox configuration. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL (the password must match the one inside DATABASE_URL)
POSTGRES_USER=codebox
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=codebox
DATABASE_URL=postgresql+psycopg://codebox:change-me-postgres-password@postgres:5432/codebox

REDIS_URL=redis://redis:6379/0

# REQUIRED: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
JWT_SECRET=

# AI assistant (optional). Leave both keys empty to run without AI.
# OpenRouter (https://openrouter.ai/keys) is used when OPENROUTER_API_KEY is set.
# Model ids: https://openrouter.ai/models (ids ending in ":free" cost nothing).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# ...otherwise any OpenAI-compatible Chat Completions API via these:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Registration checks that the email can receive mail (domain has a mail server),
# applies Gmail's username rules to @gmail.com addresses, suggests fixes for typos
# like "gmal.co" and blocks throwaway inboxes. No email is ever sent.
EMAIL_CHECK_DELIVERABILITY=true

# Sandbox limits for each program run
EXECUTION_TIMEOUT=2
MEMORY_LIMIT=128m
CPU_LIMIT=0.5
PIDS_LIMIT=64
# Limits for the separate compile container (Java, C++)
COMPILE_TIMEOUT=15
COMPILE_MEMORY_LIMIT=512m
COMPILE_CPU_LIMIT=1.0
# Optional hardened OCI runtime for sandbox containers, e.g. runsc (gVisor)
SANDBOX_RUNTIME=

# Number of programs executed in parallel by the worker
WORKER_CONCURRENCY=2

# Host ports (bound to localhost only)
FRONTEND_PORT=8080
BACKEND_PORT=8000
